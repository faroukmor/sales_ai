APP_NAME=Sales AI 2.0
APP_ENV=development
LOG_LEVEL=INFO

GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_POWERFUL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
GROQ_REASONING_EFFORT_FAST=low
GROQ_REASONING_EFFORT_POWERFUL=medium
GROQ_ALLOW_POWERFUL_FALLBACK=true
INTENT_API_ENABLED=true
INTENT_VALIDATION_DEBUG=false

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_USER=sales_ai
POSTGRES_PASSWORD=replace_with_a_secure_password
POSTGRES_DB=sales_ai

# Optional; integration tests require a separate database ending in _test.
TEST_DATABASE_URL=

EMBEDDING_MODEL=intfloat/multilingual-e5-small
